+\bibitem{gamma2000} GAMMA, Erich et al. \textbf{Padr\~oes de projeto}: solu\c{c}\~oes reutiliz\'aveis de software orientado a objetos. Porto Alegre: Bookman, 2000.
+\bibitem{martin2011} MARTIN, Robert C. \textbf{C\'odigo limpo}: habilidades pr\'aticas do Agile software. Rio de Janeiro: Alta Books, 2011.
+\bibitem{sommerville2019} SOMMERVILLE, Ian. \textbf{Engenharia de software}. 10. ed. S\~ao Paulo: Pearson Education do Brasil, 2019.
+\end{thebibliography}
+\end{document}
